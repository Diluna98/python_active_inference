include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
recursive-include docs *.md
recursive-include examples *.py *.md *.png *.gif

prune profiling_results
prune PyAIF/likelihood_models

global-exclude *.csv
global-exclude *.jsonl
global-exclude *.log
global-exclude *.npy
global-exclude *.npz
global-exclude *.zip
